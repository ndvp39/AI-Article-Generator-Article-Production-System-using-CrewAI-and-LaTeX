{
  "setup": {
    "version": "1.00",
    "article": {
      "target_pages": 15,
      "language": "hebrew",
      "bidi_language": "english",
      "citation_style": "numeric",
      "min_chapters": 4,
      "min_references": 5,
      "min_searches": 3
    },
    "agents": {
      "claude_model": "claude-sonnet-4-6",
      "gemini_model": "gemini/gemini-2.0-flash",
      "temperature": 0.7,
      "max_tokens": 16000,
      "max_iter": 10
    },
    "latex": {
      "engine": "xelatex",
      "passes": 4,
      "output_dir": "results",
      "figures_dir": "figures",
      "timeout_seconds": 120
    },
    "cost": {
      "budget_alert_usd": 1.00,
      "pricing_config": "model_pricing.json"
    },
    "logging": {
      "level": "INFO",
      "format": "%(asctime)s [%(levelname)s] %(name)s: %(message)s"
    }
  }
}
