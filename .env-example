# Copy this file to .env and fill in your real API keys.
# NEVER commit .env to version control.

# ── LLM Provider Toggle ──────────────────────────────────────────────────────
# Set to "claude" (default) or "gemini" to choose the active LLM provider.
ACTIVE_LLM=claude

# ── LLM Tier ─────────────────────────────────────────────────────────────────
# Set to "free" (default) or "pro" to select the rate-limit tier from
# config/rate_limits.json.  Determines RPM, TPM, and retry-backoff values.
LLM_TIER=free

# ── Anthropic Claude ─────────────────────────────────────────────────────────
# Required when ACTIVE_LLM=claude
# Get your key at: https://console.anthropic.com
LLM_API_KEY=your_anthropic_api_key_here

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Required when ACTIVE_LLM=gemini
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Serper (Google Search) ────────────────────────────────────────────────────
# Required by the ResearcherAgent for live internet search — always needed.
# Get your key at: https://serper.dev
SERPER_API_KEY=your_serper_api_key_here
